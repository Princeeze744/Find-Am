@import "tailwindcss";

:root {
  --bone: #FAF7F2;
  --ink: #14201B;
  --green: #0F6E56;
  --green-deep: #0A4A3A;
  --mint: #E4F5EE;
  --gold: #B78A2E;
  --line: rgba(20, 32, 27, 0.08);
}

body {
  background: var(--bone);
  color: var(--ink);
  font-family: var(--font-inter), system-ui, sans-serif;
}

.fa-serif { font-family: var(--font-fraunces), Georgia, serif; }

.fa-surface {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 1.25rem;
  box-shadow:
    0 1px 2px rgba(20, 32, 27, 0.04),
    0 10px 30px rgba(20, 32, 27, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.fa-tile {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 1rem;
  box-shadow: 0 1px 2px rgba(20, 32, 27, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease;
}
.fa-tile:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(20, 32, 27, 0.08), 0 14px 34px rgba(20, 32, 27, 0.1);
}

.fa-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: linear-gradient(180deg, #128a6b 0%, var(--green) 55%, var(--green-deep) 100%);
  color: #ECFDF5;
  border-radius: 0.9rem;
  padding: 0.85rem 1.5rem;
  font-weight: 600;
  box-shadow: 0 2px 6px rgba(15, 110, 86, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.fa-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(15, 110, 86, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
.fa-btn:active { transform: translateY(0) scale(0.98); }

.fa-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: var(--mint);
  color: var(--green-deep);
  border: 1px solid rgba(15, 110, 86, 0.18);
  border-radius: 999px;
  padding: 0.2rem 0.65rem;
  font-size: 0.72rem;
  font-weight: 600;
}

.fa-input {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 1rem;
  box-shadow: inset 0 2px 4px rgba(20, 32, 27, 0.05);
}

@keyframes fa-rise {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}
.fa-rise { animation: fa-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }

@media (prefers-reduced-motion: reduce) {
  .fa-rise { animation: none; }
  .fa-tile, .fa-btn { transition: none; }
}