@import "tailwindcss";

:root {
  --bone: #FAF7F2;
  --ink: #14201B;
  --green: #0F6E56;
  --green-deep: #0A4A3A;
  --green-dark: #073327;
  --mint: #E4F5EE;
  --gold: #B78A2E;
  --line: rgba(20, 32, 27, 0.08);
  --muted: #5A6B63;
}

html { scroll-behavior: smooth; }

body {
  background:
    radial-gradient(1200px 500px at 85% -10%, rgba(15, 110, 86, 0.07), transparent 60%),
    radial-gradient(900px 400px at -10% 20%, rgba(183, 138, 46, 0.05), transparent 55%),
    var(--bone);
  color: var(--ink);
  font-family: var(--font-inter), system-ui, sans-serif;
}

.fa-serif { font-family: var(--font-fraunces), Georgia, serif; }

.fa-nav {
  background: rgba(250, 247, 242, 0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}

.fa-surface {
  background: linear-gradient(180deg, #ffffff 0%, #fdfcf9 100%);
  border: 1px solid var(--line);
  border-radius: 1.4rem;
  box-shadow:
    0 1px 2px rgba(20, 32, 27, 0.04),
    0 12px 32px rgba(20, 32, 27, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.fa-tile {
  background: linear-gradient(180deg, #ffffff 0%, #fcfaf6 100%);
  border: 1px solid var(--line);
  border-radius: 1.1rem;
  box-shadow: 0 1px 2px rgba(20, 32, 27, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, border-color 0.25s ease;
}
.fa-tile:hover {
  transform: translateY(-3px);
  border-color: rgba(15, 110, 86, 0.3);
  box-shadow: 0 4px 12px rgba(20, 32, 27, 0.08), 0 18px 40px rgba(20, 32, 27, 0.12);
}

.fa-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: linear-gradient(180deg, #139271 0%, var(--green) 50%, var(--green-deep) 100%);
  color: #ECFDF5;
  border-radius: 1rem;
  padding: 0.9rem 1.6rem;
  font-weight: 600;
  box-shadow:
    0 2px 6px rgba(15, 110, 86, 0.35),
    0 8px 22px rgba(15, 110, 86, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.fa-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(15, 110, 86, 0.4), 0 12px 30px rgba(15, 110, 86, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.28); }
.fa-btn:active { transform: translateY(0) scale(0.98); }

.fa-btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: #ffffff;
  color: var(--green-deep);
  border: 1px solid rgba(15, 110, 86, 0.25);
  border-radius: 1rem;
  padding: 0.9rem 1.6rem;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(20, 32, 27, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, border-color 0.2s ease;
}
.fa-btn-ghost:hover { transform: translateY(-1px); border-color: rgba(15, 110, 86, 0.5); }

.fa-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: var(--mint);
  color: var(--green-deep);
  border: 1px solid rgba(15, 110, 86, 0.18);
  border-radius: 999px;
  padding: 0.22rem 0.7rem;
  font-size: 0.72rem;
  font-weight: 600;
}

.fa-chip {
  display: inline-flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.45rem 0.95rem;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--muted);
  box-shadow: 0 1px 2px rgba(20, 32, 27, 0.04);
  transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}
.fa-chip:hover { border-color: rgba(15, 110, 86, 0.35); color: var(--green-deep); transform: translateY(-1px); }

.fa-input {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 1.1rem;
  box-shadow: inset 0 2px 5px rgba(20, 32, 27, 0.05), 0 1px 0 rgba(255, 255, 255, 0.8);
}

.fa-panel {
  background:
    radial-gradient(600px 300px at 90% 0%, rgba(19, 146, 113, 0.35), transparent 60%),
    linear-gradient(180deg, var(--green-deep) 0%, var(--green-dark) 100%);
  border-radius: 1.6rem;
  color: #ECFDF5;
  box-shadow: 0 20px 50px rgba(7, 51, 39, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

.fa-step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 0.85rem;
  background: var(--mint);
  color: var(--green-deep);
  font-weight: 700;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 1px 3px rgba(20, 32, 27, 0.08);
}

@keyframes fa-rise {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}
.fa-rise { animation: fa-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both; }

@media (prefers-reduced-motion: reduce) {
  .fa-rise { animation: none; }
  .fa-tile, .fa-btn, .fa-btn-ghost, .fa-chip { transition: none; }
}